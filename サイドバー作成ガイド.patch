+"use client";
+
+import React from "react";
+import Link from "next/link";
+import { usePathname, useSearchParams } from "next/navigation";
+import { Users, History } from "lucide-react";
+
+import { cn } from "@/lib/utils";
+import { Separator } from "@/components/ui/separator";
+import { Button } from "@/components/ui/button";
+import {
+  Tooltip,
+  TooltipContent,
+  TooltipTrigger,
+} from "@/components/ui/tooltip";
+import {
+  SidebarContent,
+  SidebarFooter,
+  SidebarHeader,
+} from "@/components/ui/sidebar";
+
+import { MemberListPanel } from "./MemberListPanel";
+import { SosoPointTimelinePanel } from "./SosoPointTimelinePanel";
+
+type Props = {
+  calenderId: string;
+};
+
+type SidebarTab = "members" | "timeline";
+
+function parseTab(value: string | null): SidebarTab {
+  return value === "timeline" ? "timeline" : "members";
+}
+
+export function CalenderDetailSidebarBody({ calenderId }: Props) {
+  const pathname = usePathname();
+  const searchParams = useSearchParams();
+
+  const tab = parseTab(searchParams.get("sidebar"));
+
+  const makeHref = (next: SidebarTab) => {
+    const sp = new URLSearchParams(searchParams.toString());
+    sp.set("sidebar", next);
+    const qs = sp.toString();
+    return qs ? `${pathname}?${qs}` : pathname;
+  };
+
+  return (
+    <div className="flex h-full flex-col">
+      <SidebarHeader className="px-3 py-3">
+        <div className="space-y-1">
+          <div className="text-sm font-semibold">
+            {tab === "members" ? "メンバー一覧" : "SOSoポイントタイムライン"}
+          </div>
+          <div className="text-xs text-slate-500">
+            {tab === "members"
+              ? "参加メンバーの車情報とSOSoポイント"
+              : "SOSoポイントの変更履歴"}
+          </div>
+        </div>
+      </SidebarHeader>
+
+      <Separator />
+
+      <SidebarContent className="flex-1 p-3">
+        {tab === "members" ? (
+          <MemberListPanel calenderId={calenderId} />
+        ) : (
+          <SosoPointTimelinePanel calenderId={calenderId} />
+        )}
+      </SidebarContent>
+
+      <Separator />
+
+      <SidebarFooter className="p-2">
+        <div className="grid grid-cols-2 gap-2">
+          <Tooltip>
+            <TooltipTrigger asChild>
+              <Button
+                asChild
+                variant={tab === "members" ? "secondary" : "ghost"}
+                className={cn("h-10 w-full")}
+              >
+                <Link href={makeHref("members")} aria-label="メンバー一覧">
+                  <Users className="h-5 w-5" />
+                </Link>
+              </Button>
+            </TooltipTrigger>
+            <TooltipContent>メンバー一覧</TooltipContent>
+          </Tooltip>
+
+          <Tooltip>
+            <TooltipTrigger asChild>
+              <Button
+                asChild
+                variant={tab === "timeline" ? "secondary" : "ghost"}
+                className={cn("h-10 w-full")}
+              >
+                <Link href={makeHref("timeline")} aria-label="SOSoポイント履歴">
+                  <History className="h-5 w-5" />
+                </Link>
+              </Button>
+            </TooltipTrigger>
+            <TooltipContent>SOSoポイント履歴</TooltipContent>
+          </Tooltip>
+        </div>
+      </SidebarFooter>
+    </div>
+  );
+}
