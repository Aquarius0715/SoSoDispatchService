+"use client";
+
+import React from "react";
+import useSWR from "swr";
+
+import type { CalenderMember, SosoPointHistory } from "@/types/interfaces";
+import { listCalenderMembers, listSosoPointHistory } from "@/requests/calenderDetailAPI";
+
+import { Card, CardContent } from "@/components/ui/card";
+import { Skeleton } from "@/components/ui/skeleton";
+
+type Props = {
+  calenderId: string;
+};
+
+function formatChangedAt(value: string) {
+  try {
+    return new Date(value).toLocaleString("ja-JP", {
+      year: "numeric",
+      month: "2-digit",
+      day: "2-digit",
+      hour: "2-digit",
+      minute: "2-digit",
+    });
+  } catch {
+    return value;
+  }
+}
+
+function formatEventLabel(eventId?: string) {
+  if (!eventId) return "イベント（不明）";
+  const short = eventId.length > 10 ? `${eventId.slice(0, 10)}…` : eventId;
+  return `イベント: ${short}`;
+}
+
+export function SosoPointTimelinePanel({ calenderId }: Props) {
+  const membersSWR = useSWR<CalenderMember[]>(
+    calenderId ? ["calenderMembers", calenderId] : null,
+    () => listCalenderMembers(calenderId)
+  );
+  const historySWR = useSWR<SosoPointHistory[]>(
+    calenderId ? ["sosoPointHistory", calenderId] : null,
+    () => listSosoPointHistory(calenderId)
+  );
+
+  const isLoading = membersSWR.isLoading || historySWR.isLoading;
+  const error = membersSWR.error || historySWR.error;
+
+  if (isLoading) {
+    return (
+      <div className="space-y-2">
+        {Array.from({ length: 6 }).map((_, i) => (
+          <Card key={i}>
+            <CardContent className="p-3 space-y-2">
+              <div className="flex items-center justify-between gap-3">
+                <Skeleton className="h-3 w-28" />
+                <Skeleton className="h-3 w-20" />
+              </div>
+              <Skeleton className="h-4 w-full" />
+              <Skeleton className="h-3 w-5/6" />
+            </CardContent>
+          </Card>
+        ))}
+      </div>
+    );
+  }
+
+  if (error) {
+    return (
+      <div className="text-sm text-destructive">
+        SOSoポイント履歴の取得に失敗しました
+      </div>
+    );
+  }
+
+  const members = membersSWR.data ?? [];
+  const historiesRaw = historySWR.data ?? [];
+
+  if (historiesRaw.length === 0) {
+    return <div className="text-sm text-muted-foreground">履歴がまだありません</div>;
+  }
+
+  const nameMap = new Map(members.map((m) => [m.id, m.username]));
+
+  const histories = [...historiesRaw].sort((a, b) => {
+    const at = Date.parse(a.changedAt);
+    const bt = Date.parse(b.changedAt);
+    return (Number.isNaN(bt) ? 0 : bt) - (Number.isNaN(at) ? 0 : at);
+  });
+
+  return (
+    <div className="space-y-2">
+      {histories.map((h) => {
+        const changerName = h.changedBy ? (nameMap.get(h.changedBy) ?? "不明") : "システム";
+        const targetName = nameMap.get(h.userId) ?? "不明";
+
+        const delta = h.pointDelta ?? (h.newPoint - h.oldPoint);
+        const deltaText = `${delta > 0 ? "+" : ""}${delta}pt`;
+
+        return (
+          <Card key={h.id}>
+            <CardContent className="p-3">
+              <div className="flex items-start justify-between gap-3">
+                <div className="text-sm font-medium">{formatEventLabel(h.eventId)}</div>
+                <div className="text-xs text-muted-foreground">{formatChangedAt(h.changedAt)}</div>
+              </div>
+
+              <div className="mt-2 text-sm leading-relaxed">
+                <span className="font-medium">{changerName}</span> が{' '}
+                <span className="font-medium">{targetName}</span> のSOSoポイントを{' '}
+                <span className="font-medium">{deltaText}</span> 変更
+              </div>
+
+              <div className="mt-1 text-xs text-muted-foreground">理由：{h.reason?.trim() ? h.reason : "—"}</div>
+            </CardContent>
+          </Card>
+        );
+      })}
+    </div>
+  );
+}
